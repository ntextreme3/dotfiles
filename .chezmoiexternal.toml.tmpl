{{- if eq .osid "linux-ubuntu" }}

[".local/bin/age"]
    type = "archive-file"
    url = {{ includeTemplate "github-release-asset-url" (dict "repo" "FiloSottile/age" "asset" (printf "age-*-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch)) | quote }}
    executable = true
    path = "age/age"

[".local/bin/age-keygen"]
    type = "archive-file"
    url = {{ includeTemplate "github-release-asset-url" (dict "repo" "FiloSottile/age" "asset" (printf "age-*-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch)) | quote }}
    executable = true
    path = "age/age-keygen"

